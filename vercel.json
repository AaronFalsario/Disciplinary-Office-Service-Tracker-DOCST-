{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/Assets/Admin dashboard/(.*)",
      "destination": "/Assets/Admin dashboard/$1"
    },
    {
      "source": "/Assets/Admin%20dashboard/(.*)",
      "destination": "/Assets/Admin%20dashboard/$1"
    },
    {
      "source": "/Assets/Student Authentication/(.*)",
      "destination": "/Assets/Student Authentication/$1"
    },
    {
      "source": "/Assets/Student%20Authentication/(.*)",
      "destination": "/Assets/Student%20Authentication/$1"
    },
    {
      "source": "/Assets/Landing/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/Assets/Landing/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/Assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}